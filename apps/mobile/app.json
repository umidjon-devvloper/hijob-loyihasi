{
  "expo": {
    "name": "N2431",
    "slug": "n2431",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "n2431",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#8A8D5B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.hijab.app",
      "infoPlist": {
        "NSCameraUsageDescription": "24:31 real-time try-on uchun kameraga ruxsat so'raydi.",
        "NSPhotoLibraryUsageDescription": "Kutubxonaga faqat sizning ruxsatingiz bilan kirish.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "24:31"
      }
    },
    "android": {
      "package": "uz.hijab.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8A8D5B"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "24:31 kamerani yuzingizni skanerlash uchun ishlatadi."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "24:31 real-time try-on uchun kameraga ruxsat so'raydi.",
          "enableFrameProcessors": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlayfairDisplay.ttf",
            "./assets/fonts/Inter.ttf"
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.2431.uz/api/v1",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4ef75232-4085-433d-b613-6fb7e46092bb"
      }
    },
    "owner": "umidjon_looksave_developer"
  }
}
